{
  // Compiles the one-off tools (prisma seeds, scripts/) to plain CommonJS JS so they
  // can run in the prod image with `node dist-tools/...` — NO ts-node at runtime.
  // ts-node fails in prod because the base tsconfig is `module: nodenext` (ESM),
  // which makes Node's loader reject a .ts file ("Unknown file extension .ts").
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolvePackageJsonExports": false,
    "incremental": false,
    "declaration": false,
    "sourceMap": false,
    "rootDir": "./",
    "outDir": "./dist-tools",
    "noEmit": false
  },
  "include": ["prisma/**/*.ts", "scripts/**/*.ts"]
}

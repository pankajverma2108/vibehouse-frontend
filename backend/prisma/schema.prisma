/// heist1.1 — WhatsApp service-request lifecycle (the Miro "Live" front door).
/// Scalar-only (no Prisma relations) on purpose: the orchestrator does explicit
/// lookups and this keeps the v1 ticket-engine models untouched. FK integrity is
/// enforced in the DB by migration 20260619000001.
model wa_service_request {
  id                       String   @id @db.VarChar(36)
  brand                    String   @db.VarChar(20)
  wa_id                    String   @db.VarChar(20)
  wati_message_id          String?  @unique @db.VarChar(100)
  guest_id                 String?  @db.VarChar(36)
  ezee_reservation_id      String?  @db.VarChar(100)
  property_id              String?  @db.VarChar(36)
  raw_text                 String
  intent                   String?  @db.VarChar(40)
  request_type             String?  @db.VarChar(20)
  product_id               String?  @db.VarChar(36)
  department               String?  @db.VarChar(30)
  task_category            String?  @db.VarChar(20)
  status                   String   @default("RECEIVED") @db.VarChar(20)
  payment_id               String?  @db.VarChar(36)
  addon_order_id           String?  @db.VarChar(36)
  razorpay_payment_link_id String?  @db.VarChar(100)
  ticket_id                String?  @db.VarChar(36)
  created_at               DateTime @default(now()) @db.Timestamp(6)
  updated_at               DateTime @default(now()) @db.Timestamp(6)

  @@index([wa_id, created_at], map: "idx_wa_service_request_wa_id")
  @@index([status], map: "idx_wa_service_request_status")
}

/// Per-prospect WhatsApp session state for the NON-GUEST (prospect) front door.
///
/// A number that isn't a checked-in guest may ask about one of a brand's several
/// properties (BUTEAK = BTM + Koramangala). We don't know which, so we ask them to
/// tap a property in the `property_selector_v3` template. This table remembers that
/// choice for the duration of a "chat session" — scoped by an idle window
/// (PROSPECT_SESSION_TTL_HOURS) so a customer who returns the next day to ask about
/// a DIFFERENT property is re-prompted rather than pinned to yesterday's pick.
///
/// One row per (brand, wa_id). `property_id` is null until they select. `pending_query`
/// holds the question they asked before selecting, so the next stage can answer it once
/// the property is known.
model wa_prospect_session {
  id               String    @id @db.VarChar(36)
  brand            String    @db.VarChar(20)
  wa_id            String    @db.VarChar(20)
  property_id      String?   @db.VarChar(36)
  pending_query    String?   @db.VarChar(2000)
  selector_sent_at DateTime? @db.Timestamp(6)
  last_message_at  DateTime  @default(now()) @db.Timestamp(6)
  created_at       DateTime  @default(now()) @db.Timestamp(6)

  @@unique([brand, wa_id], map: "uq_wa_prospect_session_brand_wa")
}

/// Group-booking room disambiguation state for the GUEST (checked-in) WhatsApp front door.
///
/// A checked-in guest whose booking spans several rooms (e.g. 101/102/103) sends a service
/// request; we can't stamp all three rooms on a ticket, so the bot asks which room and stashes
/// the original request here. The next inbound is read in that context — a bare "103" files the
/// stashed request against room 103; anything that isn't one of their rooms re-prompts; a topic
/// change (a greeting, a different ask) drops the pending request. Mirrors `wa_prospect_session`:
/// one row per (brand, wa_id), an idle window (WA_ROOM_SELECTION_TTL_MIN) enforced in app code,
/// the row deleted once the room is picked or the guest changes topic.
model wa_pending_room_selection {
  id              String   @id @db.VarChar(36)
  brand           String   @db.VarChar(20)
  wa_id           String   @db.VarChar(20)
  eri             String   @db.VarChar(50)
  guest_id        String?  @db.VarChar(36)
  property_id     String   @db.VarChar(36)
  pending_text    String   @db.VarChar(2000)
  candidate_rooms String   @db.VarChar(500)
  asked_at        DateTime @db.Timestamp(6)
  last_message_at DateTime @default(now()) @db.Timestamp(6)
  created_at      DateTime @default(now()) @db.Timestamp(6)

  @@unique([brand, wa_id], map: "uq_wa_pending_room_brand_wa")
}


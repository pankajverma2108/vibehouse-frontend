// SLA timing per task class (global — one row per T0..T3). Urgency tiers,
// department-agnostic. Two timers (ack + completion) + the gap between
// escalation ladder steps. The ladder (who) lives in escalation_levels.
model sla_config {
  id                     String   @id @db.VarChar(36)
  task_category          String   @unique @db.VarChar(20)
  completion_timeout_min Int // TAT — time to RESOLVE after acknowledging (= guest turn-around)
  ack_percent            Int // primary ack window = this % of TAT; escalate if unacked by then
  escalation_gap_min     Int // base wait between successive ladder levels
  snooze_percent         Int      @default(100) // escalated-level ack/snooze window = this % of escalation_gap_min
  is_active              Boolean  @default(true)
  updated_at             DateTime @default(now()) @db.Timestamp(6)
}


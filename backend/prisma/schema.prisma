  smart_lock_access smart_lock_access? @relation(fields: [pin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([device_id, event_at], map: "idx_lock_log_device")
  @@index([pin_id], map: "idx_lock_log_pin")
}

model stay_extensions {
  id                  String             @id @db.VarChar(36)
  ezee_reservation_id String             @db.VarChar(100)
  guest_id            String             @db.VarChar(36)
  payment_id          String?            @db.VarChar(36)
  old_checkout_date   DateTime           @db.Date
  new_checkout_date   DateTime           @db.Date
  rate_per_night      Decimal            @db.Decimal(10, 2)
  total_amount        Decimal            @db.Decimal(10, 2)
  same_bed_available  Boolean
  disclaimer_accepted Boolean            @default(false)
  ezee_sync_status    String             @default("NOT_SYNCED") @db.VarChar(20)
  status              String             @default("PENDING") @db.VarChar(20)
  created_at          DateTime           @default(now()) @db.Timestamp(6)
  ezee_booking_cache  ezee_booking_cache @relation(fields: [ezee_reservation_id], references: [ezee_reservation_id], onDelete: NoAction, onUpdate: NoAction)
  guests              guests             @relation(fields: [guest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments            payments?          @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model zoho_ticket_ref {
  id                  String              @id @db.VarChar(36)
  zoho_ticket_id      String              @unique @db.VarChar(100)
  ezee_reservation_id String?             @db.VarChar(100)
  guest_id            String?             @db.VarChar(36)
  addon_order_id      String?             @db.VarChar(36)
  ticket_type         String              @db.VarChar(20)
  department          String              @db.VarChar(30)
  room_number         String?             @db.VarChar(20)
  unit_code           String?             @db.VarChar(20)
  status              String              @default("OPEN") @db.VarChar(20)
  subject             String?             @db.VarChar(255)
  task_category       String?             @db.VarChar(5)
  priority            String              @default("MEDIUM") @db.VarChar(10)
  assigned_staff_id   String?             @db.VarChar(36)
  /// Assignee's name pinned at assignment. Survives the staff row being hard-deleted, so a
  /// historic ticket still shows who worked it once `assigned_staff_id` is nulled out.
  assigned_staff_name String?             @db.VarChar(255)
  guest_phone         String?             @db.VarChar(20)
  is_escalated        Boolean             @default(false)
  escalation_level    Int                 @default(0)
  next_deadline       DateTime?           @db.Timestamp(6)
  sla_breach_at       DateTime?           @db.Timestamp(6)
  acked_at            DateTime?           @db.Timestamp(6)
  completed_at        DateTime?           @db.Timestamp(6)
  synced_at           DateTime            @db.Timestamp(6)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  /// Raised by a test booking. Pinned at creation from `ezee_booking_cache.is_test` rather than
  /// joined, for the same reason as `assigned_staff_name` above — the ticket keeps its own truth
  /// — and so every routing/reporting filter stays a single-table predicate.
  is_test             Boolean             @default(false)
  addon_orders        addon_orders?       @relation(fields: [addon_order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ezee_booking_cache  ezee_booking_cache? @relation(fields: [ezee_reservation_id], references: [ezee_reservation_id], onDelete: NoAction, onUpdate: NoAction)
  guests              guests?             @relation(fields: [guest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff               staff?              @relation(fields: [assigned_staff_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ezee_reservation_id], map: "idx_zoho_ticket_reservation")
  @@index([status], map: "idx_zoho_ticket_status")
  @@index([status, next_deadline], map: "idx_zoho_ticket_watchdog")
  @@index([assigned_staff_id], map: "idx_zoho_ticket_assigned_staff")
}

model staff {
  id                  String            @id @db.VarChar(36)
  property_id         String            @db.VarChar(36)
  name                String            @db.VarChar(255)
  phone               String            @db.VarChar(20)
  role                String            @db.VarChar(30)
  department          String            @db.VarChar(30)
  is_available        Boolean           @default(false)
  active_ticket_count Int               @default(0)
  is_active           Boolean           @default(true)
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  updated_at          DateTime          @default(now()) @db.Timestamp(6)
  properties          properties        @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  zoho_ticket_ref     zoho_ticket_ref[]

  @@unique([property_id, phone], map: "uq_staff_property_phone")
  @@index([property_id, role, is_available, is_active], map: "idx_staff_assignment")
}

model escalation_levels {
  id            String     @id @db.VarChar(36)
  property_id   String     @db.VarChar(36)
  level         Int
  role          String     @db.VarChar(30)
  lookup_source String     @default("staff") @db.VarChar(20)
  channel       String     @default("WATI") @db.VarChar(20)
  is_active     Boolean    @default(true)
  properties    properties @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([property_id, level], map: "uq_escalation_levels_property_level")
}

// Brand-wide catalog of staff role types (HOUSEKEEPING, SUPERVISOR, …). The set of
// role *types* is global; which person fills a role at which hotel lives in `staff`,
// and where a role sits in a hotel's ladder lives in `escalation_levels`. Both the
// staff form and the escalation-ladder role picker validate against this catalog so a
// typo/casing mismatch can't silently page nobody.
model staff_roles {
  id         String   @id @db.VarChar(36)
  name       String   @unique @db.VarChar(30) // canonical, UPPER_SNAKE (e.g. FRONT_OFFICE)
  label      String?  @db.VarChar(60) // human display label (e.g. "Front Office")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

// Per-ticket flow trace: one row per module step (webhook → classify → identity →
// assign → ticket → zoho → notify → escalate → ack/complete) with input/output/latency.
// `trace_id` groups a whole request; `ticket_id` is stamped once the ticket exists
// (pre-ticket steps are back-linked), so the whole flow is queryable ticket-wise.
model flow_log {
  id         String   @id @db.VarChar(36)
  trace_id   String   @db.VarChar(36)
  ticket_id  String?  @db.VarChar(36)
  brand      String?  @db.VarChar(20)
  module     String   @db.VarChar(40) // WA_INBOUND | IDENTITY | LLM_CLASSIFY | CATALOG | TICKET_CREATE | ZOHO_CREATE | NOTIFY_STAFF | NOTIFY_GUEST | ESCALATION | ACK | COMPLETE
  input      String? // summarised / redacted
  output     String?
  status     String   @default("OK") @db.VarChar(10) // OK | ERROR | SKIP
  error      String?
  latency_ms Int?
  created_at DateTime @default(now()) @db.Timestamp(6)

  @@index([ticket_id], map: "idx_flow_log_ticket")
  @@index([trace_id], map: "idx_flow_log_trace")
}

// ─── COUPONS ─────────────────────────────────────────────────────────────────

model coupons {
  id                         String                @id @db.VarChar(36)
  code                       String?               @unique @db.VarChar(50)
  name                       String?               @db.VarChar(60)
  description                String?               @db.VarChar(255)
  type                       String                @db.VarChar(20)
  discount_type              String                @db.VarChar(10)
  discount_value             Decimal               @db.Decimal(10, 2)
  max_discount_amount        Decimal?              @db.Decimal(10, 2)
  min_stay_nights            Int?
  min_booking_amount         Decimal               @default(0) @db.Decimal(10, 2)
  max_uses_per_guest         Int                   @default(1)
  max_total_uses             Int?
  applies_to_all_properties  Boolean               @default(false)
  valid_from                 DateTime?             @db.Timestamp(6)
  valid_until                DateTime?             @db.Timestamp(6)
  is_active                  Boolean               @default(true)
  is_hidden                  Boolean               @default(false)
  admin_note                 String?
  created_by                 String                @db.VarChar(36)
  created_at                 DateTime              @default(now()) @db.Timestamp(6)
  updated_at                 DateTime              @default(now()) @db.Timestamp(6)
  admin_users                admin_users           @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coupon_properties          coupon_properties[]
  coupon_redemptions         coupon_redemptions[]
  ezee_booking_cache_auto    ezee_booking_cache[]  @relation("ezee_booking_cache_coupon_auto")
  ezee_booking_cache_code    ezee_booking_cache[]  @relation("ezee_booking_cache_coupon_code")

  @@index([type, is_active], map: "idx_coupons_type_active")
  @@index([valid_from, valid_until], map: "idx_coupons_valid_window")
}

model coupon_properties {
  coupon_id   String     @db.VarChar(36)
  property_id String     @db.VarChar(36)
  coupons     coupons    @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([coupon_id, property_id])
  @@index([property_id], map: "idx_coupon_properties_property")
}

model coupon_redemptions {
  id                  String             @id @db.VarChar(36)
  coupon_id           String             @db.VarChar(36)
  guest_id            String             @db.VarChar(36)
  ezee_reservation_id String             @db.VarChar(100)
  property_id         String             @db.VarChar(36)
  payment_id          String?            @db.VarChar(36)
  discount_amount     Decimal            @db.Decimal(10, 2)
  applied_at          DateTime           @default(now()) @db.Timestamp(6)
  kind                String             @db.VarChar(10)
  coupons             coupons            @relation(fields: [coupon_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guests              guests             @relation(fields: [guest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ezee_booking_cache  ezee_booking_cache @relation(fields: [ezee_reservation_id], references: [ezee_reservation_id], onDelete: NoAction, onUpdate: NoAction)
  payments            payments?          @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties          properties         @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([coupon_id], map: "idx_redemptions_coupon")
  @@index([guest_id, coupon_id], map: "idx_redemptions_guest_coupon")
  @@index([ezee_reservation_id], map: "idx_redemptions_eri")
  @@index([payment_id], map: "idx_redemptions_payment")
}

/// Breakfast pre-ordering (BRD docs/plans/breakfast_brd.md, Phase 1).
/// Cross-domain refs (property_id / ezee_reservation_id / guest_id) are scalar-only —
/// same decoupled style as `ticket_feedback` / `wa_service_request` — so the shared
/// `properties`/`guests`/`ezee_booking_cache` models are untouched; those FKs are
/// enforced in the DB by the breakfast migration. Relations WITHIN the breakfast domain
/// (order ↔ items ↔ slot) are modelled so nested reads (`include`) stay clean.

/// Admin-managed breakfast menu catalog (per property). No inventory/stock tracking in
/// Phase 1 — remove = soft-delete (`is_active=false`) so historic orders keep resolving.
model breakfast_menu_item {
  id                    String                 @id @db.VarChar(36)
  property_id           String                 @db.VarChar(36)
  name                  String                 @db.VarChar(255)
  description           String?
  category              String                 @default("MAIN") @db.VarChar(20)
  is_veg                Boolean                @default(true)
  forecast_key          String?                @db.VarChar(100)
  sort_order            Int                    @default(0)
  is_active             Boolean                @default(true)
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @default(now()) @db.Timestamp(6)
  breakfast_order_items breakfast_order_item[]

  @@index([property_id, is_active], map: "idx_breakfast_menu_property")
}

/// Delivery-slot DEFINITIONS (recur daily). Per-date booked counts are derived by
/// counting PLACED orders — no per-date slot rows. `capacity` is admin-configurable.
model breakfast_slot {
  id               String            @id @db.VarChar(36)
  property_id      String            @db.VarChar(36)
  slot_number      Int
  label            String            @db.VarChar(50)
  start_min        Int
  end_min          Int
  capacity         Int               @default(12)
  sort_order       Int               @default(0)
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  breakfast_plates breakfast_plate[]

  @@unique([property_id, slot_number], map: "uq_breakfast_slot_property_number")
  @@index([property_id, is_active], map: "idx_breakfast_slot_property")
}

/// One breakfast order per ROOM per service_date. A multi-room eZee booking is ONE reservation
/// (one cache row) with one BookingTran per room, so the room key is `sub_booking_id` (eZee's
/// SubBookingId, e.g. "109-2"), falling back to the reservation id for single-room bookings and
/// for rows eZee gave no sub-booking for. A resubmit MODIFIES the same row (unique on
/// eri+sub+date). The room's meals are its `breakfast_plates` — one plate per adult who wants
/// breakfast; each plate carries its OWN delivery slot + dishes. `no_of_guests` snapshots the
/// plate count. room_number is snapshotted for the admin board.
model breakfast_order {
  id                  String            @id @db.VarChar(36)
  property_id         String            @db.VarChar(36)
  ezee_reservation_id String            @db.VarChar(100)
  sub_booking_id      String            @db.VarChar(100)
  guest_id            String?           @db.VarChar(36)
  brand               String            @db.VarChar(20)
  service_date        DateTime          @db.Date
  status              String            @default("PLACED") @db.VarChar(20)
  no_of_guests        Int?
  room_number         String?           @db.VarChar(20)
  placed_via          String            @default("CX_LINK") @db.VarChar(20)
  created_at          DateTime          @default(now()) @db.Timestamp(6)
  updated_at          DateTime          @default(now()) @db.Timestamp(6)
  /// Ordered against a test booking. Denormalised from `ezee_booking_cache.is_test` because
  /// `ezee_reservation_id` here is a scalar-only cross-domain FK (see the note on that field) —
  /// there is no relation to join through. The kitchen forecast subtracts these: nobody should
  /// cook a plate for a guest who doesn't exist.
  is_test             Boolean           @default(false)
  breakfast_plates    breakfast_plate[]

  @@unique([ezee_reservation_id, sub_booking_id, service_date], map: "uq_breakfast_order_eri_sub_date")
  @@index([property_id, service_date], map: "idx_breakfast_order_property_date")
}

/// One plate = one adult's breakfast: its own delivery `slot_id` and its own dishes
/// (`breakfast_order_items`). Plates belong to a room order; `plate_number` is 1..N within
/// the room. Slot CAPACITY is counted in PLATES (not rooms). Cascade-deleted when the
/// order is replaced.
model breakfast_plate {
  id                    String                 @id @db.VarChar(36)
  order_id              String                 @db.VarChar(36)
  plate_number          Int
  slot_id               String                 @db.VarChar(36)
  status                String                 @default("PLACED") @db.VarChar(20)
  special_requests      String?                @db.VarChar(500)
  created_at            DateTime               @default(now()) @db.Timestamp(6)
  updated_at            DateTime               @default(now()) @db.Timestamp(6)
  breakfast_order       breakfast_order        @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  breakfast_slot        breakfast_slot         @relation(fields: [slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  breakfast_order_items breakfast_order_item[]

  @@index([order_id], map: "idx_breakfast_plate_order")
  @@index([slot_id], map: "idx_breakfast_plate_slot")
}

/// Line items on a PLATE (dishes for that one adult). qty per item. Cascade-deleted when
/// the plate is replaced/removed.
model breakfast_order_item {
  id                  String              @id @db.VarChar(36)
  plate_id            String              @db.VarChar(36)
  menu_item_id        String              @db.VarChar(36)
  qty                 Int                 @default(1)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  breakfast_plate     breakfast_plate     @relation(fields: [plate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  breakfast_menu_item breakfast_menu_item @relation(fields: [menu_item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([plate_id], map: "idx_breakfast_order_item_plate")
}

/// Per-stay Cx link credential. Only the SHA-256 of the token is stored (never the raw
/// token) — same discipline as `ticket_feedback`/`otp_logs`. One reusable token per stay;
/// live validity is still gated by the booking's CHECKED_IN state, `expires_at` is a backstop.
model breakfast_access_token {
  id                  String    @id @db.VarChar(36)
  ezee_reservation_id String    @db.VarChar(100)
  guest_id            String?   @db.VarChar(36)
  property_id         String    @db.VarChar(36)
  brand               String    @db.VarChar(20)
  token_hash          String    @unique @db.VarChar(64)
  issued_at           DateTime  @default(now()) @db.Timestamp(6)
  revoked_at          DateTime? @db.Timestamp(6)
  expires_at          DateTime  @db.Timestamp(6)
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([ezee_reservation_id], map: "idx_breakfast_token_eri")
}

/// Per-property breakfast on/off toggle (admin-controlled). One row per property
/// (property_id is the PK). Absent row ⇒ disabled (opt-in). When disabled: the Cx page
/// returns `disabled`, invites are skipped, and ordering is blocked — but menu/slot
/// setup stays editable so a property can be configured before it goes live.
model breakfast_config {
  property_id           String    @id @db.VarChar(36)
  is_enabled            Boolean   @default(false)
  /// Ordering window (IST, per property). Orders open at `order_open_hour` the evening before
  /// and freeze at `order_freeze_hour` on the service morning (default 11:00 open → 07:00 freeze,
  /// i.e. frozen 07:00–11:00). Admin-configurable so the inactive hours aren't hardcoded.
  order_open_hour       Int       @default(11)
  order_freeze_hour     Int       @default(7)
  /// Auto-send scheduler: fire at `invite_anchor_min` (mins from IST midnight, default
  /// 18:00) then every `invite_interval_hours` (default 24 = once daily). `last_invite_run_at`
  /// dedupes firings across the poll tick. Gated by `invite_cron_enabled` (per-property) under
  /// the global BREAKFAST_INVITE_CRON_ENABLED master switch.
  invite_cron_enabled   Boolean   @default(false)
  invite_anchor_min     Int       @default(1080)
  invite_interval_hours Int       @default(24)
  last_invite_run_at    DateTime? @db.Timestamp(6)
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  updated_at            DateTime  @default(now()) @db.Timestamp(6)
}
